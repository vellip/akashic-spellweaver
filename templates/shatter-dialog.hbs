<div class="standard-form">
    <div class="form-group">
        <label class="shatter-label">
            {{localize 'shatter.slots'}}
        </label>
        <div class="form-control">
            <select name="slot" id="shatter-slots">
                {{#each slots}}
                    <option value="{{this.id}}" data-essences="{{this.essence}}">
                        {{this.slot}} – {{translate "shatter.essence" count=this.essence}} {{#if this.bound}}
                        [bound]{{/if}}
                    </option>
                {{/each}}
            </select>
        </div>
    </div>
    <div class="form-group">
        <label class="shatter-label">
            {{localize 'shatter.effect'}}
        </label>
        <div class="form-control">
            <select name="effect" id="shatter-effect">
                {{#each effects}}
                    <option value="{{@key}}">{{this.label}}</option>
                {{/each}}
            </select>
        </div>
    </div>
    {{#each effects}}
        <div class="effect-description {{#unless @first}}hidden{{/unless}}" data-effect="{{@key}}">
            <h4>{{this.label}}</h4>
            <p data-description="{{@key}}">{{this.description}}</p>
        </div>
    {{/each}}
</div>